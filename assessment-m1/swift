// R4: Throwing Validation Function Handling Two Distinct Errors
// ============================================================================
enum RegistrationError: Error {
    case emptyUsername
    case weakPassword(minLength: Int)
}

func validateRegistration(username: String, password: String) throws -> String {
    guard !username.trimmingCharacters(in: .whitespaces).isEmpty else {
        throw RegistrationError.emptyUsername
    }
    guard password.count >= 8 else {
        throw RegistrationError.weakPassword(minLength: 8)
    }
    return "User '\(username)' registered successfully!"
}

func runR4() {
    print("--- R4: Throwing Validation Function ---")
    let testInputs = [
        ("", "password123"),
        ("bharat_dev", "1234"),
        ("bharat_dev", "Swift@2026")
    ]

    for (user, pass) in testInputs {
        do {
            let message = try validateRegistration(username: user, password: pass)
            print(message)
        } catch RegistrationError.emptyUsername {
            print("Validation Failed: Username cannot be empty.")
        } catch RegistrationError.weakPassword(let minLength) {
            print("Validation Failed: Password must be at least \(minLength) characters long.")
        } catch {
            print("Unexpected error: \(error)")
        }
    }
    print()
}

