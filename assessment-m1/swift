import Foundation

// ============================================================================
// R1: Gradebook Using Arrays/Dictionaries and Safe Optionals
// ============================================================================
struct Gradebook {
    private var records: [String: [Int]] = [:]

    mutating func addStudent(_ name: String, scores: [Int]) {
        records[name] = scores
    }

    func averageScore(for student: String) -> Double? {
        guard let scores = records[student], !scores.isEmpty else {
            return nil
        }
        let total = scores.reduce(0, +)
        return Double(total) / Double(scores.count)
    }

    func printReport(for student: String) {
        if let avg = averageScore(for: student) {
            print("\(student)'s Average: \(String(format: "%.2f", avg))")
        } else {
            print("No valid grade records found for \(student).")
        }
    }
}

func runR1() {
    print("--- R1: Gradebook ---")
    var gradebook = Gradebook()
    gradebook.addStudent("Bharat", scores: [88, 92, 95])
    gradebook.addStudent("Aarav", scores: [])

    gradebook.printReport(for: "Bharat")
    gradebook.printReport(for: "Aarav")
    gradebook.printReport(for: "Riya")
    print()
}

// ============================================================================
// R2: Generic Stack<T> Demonstrated with Two Element Types
// ============================================================================
struct Stack<T> {
    private var items: [T] = []

    var isEmpty: Bool {
        return items.isEmpty
    }

    mutating func push(_ element: T) {
        items.append(element)
    }

    @discardableResult
    mutating func pop() -> T? {
        return items.popLast()
    }

    func peek() -> T? {
        return items.last
    }
}

func runR2() {
    print("--- R2: Generic Stack<T> ---")
    var intStack = Stack<Int>()
    intStack.push(10)
    intStack.push(20)
    print("Int Stack Peek:", intStack.peek() ?? -1)
    print("Int Stack Pop:", intStack.pop() ?? -1)

    var stringStack = Stack<String>()
    stringStack.push("Swift")
    stringStack.push("UIKit")
    print("String Stack Peek:", stringStack.peek() ?? "Empty")
    print("String Stack Pop:", stringStack.pop() ?? "Empty")
    print()
}

// ============================================================================
// R3: Fix a Retain Cycle and Explain the Fix
// ============================================================================
class Course {
    let title: String
    // FIX: Declared as 'weak' so Course does not hold a strong reference back to Student
    weak var enrolledStudent: Student?

    init(title: String) {
        self.title = title
    }

    deinit {
        print("Course '\(title)' deallocated.")
    }
}

class Student {
    let name: String
    var activeCourse: Course?

    init(name: String) {
        self.name = name
    }

    deinit {
        print("Student '\(name)' deallocated.")
    }
}

func runR3() {
    print("--- R3: Retain Cycle Fix ---")
    var student: Student? = Student(name: "Bharat")
    var course: Course? = Course(title: "iOS Development")

    student?.activeCourse = course
    course?.enrolledStudent = student

    // Breaking external references triggers deinit for both objects
    student = nil
    course = nil
    print()
}

/*
 R3 EXPLANATION:
 In Swift, Automatic Reference Counting (ARC) deallocates an instance only when its
 strong reference count drops to zero. Previously, Student held a strong reference to
 Course, and Course held a strong reference back to Student, creating a strong reference
 cycle (retain cycle) that leaked memory even after setting both variables to nil.
 Marking 'enrolledStudent' as 'weak' breaks the cycle because a weak reference does not
 increment the retain count and automatically becomes nil when the Student instance is deallocated.
 */

