import UIKit

// ============================================================================
// Model Passed Safely Between Screens (No Global Variables)
// ============================================================================
struct CourseModule {
    let code: String
    let title: String
    let instructor: String
    let credits: Int
    let summary: String
}

// ============================================================================
// Screen 1: List View Controller (Tasks 1 & 3)
// ============================================================================
final class CourseListViewController: UIViewController, UITableViewDataSource, UITableViewDelegate {

    private let modules: [CourseModule] = [
        CourseModule(
            code: "CS301",
            title: "iOS App Development",
            instructor: "Dr. Ananya Verma",
            credits: 4,
            summary: "Covers UIKit, SwiftUI, Auto Layout, navigation hierarchies, and structured concurrency."
        ),
        CourseModule(
            code: "CS305",
            title: "Database Management Systems",
            instructor: "Prof. Rajesh Nair",
            credits: 4,
            summary: "Relational schema design, SQL query optimization, transactions, and indexing."
        ),
        CourseModule(
            code: "CS310",
            title: "Operating Systems",
            instructor: "Dr. Meera Kulkarni",
            credits: 3,
            summary: "Process scheduling, virtual memory, deadlocks, and file system architecture."
        )
    ]

    private let tableView: UITableView = {
        let tv = UITableView(frame: .zero, style: .insetGrouped)
        tv.translatesAutoresizingMaskIntoConstraints = false
        return tv
    }()

    override func viewDidLoad() {
        super.viewDidLoad()
        title = "Course Modules"
        view.backgroundColor = .systemGroupedBackground
        setupTableView()
    }

    private func setupTableView() {
        view.addSubview(tableView)
        tableView.dataSource = self
        tableView.delegate = self

        NSLayoutConstraint.activate([
            tableView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            tableView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            tableView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            tableView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
        ])
    }

    // MARK: - UITableViewDataSource
    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
        modules.count
    }

    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(withIdentifier: "ModuleCell")
            ?? UITableViewCell(style: .subtitle, reuseIdentifier: "ModuleCell")

        let module = modules[indexPath.row]
        var content = cell.defaultContentConfiguration()
        content.text = "\(module.code): \(module.title)"
        content.secondaryText = "Instructor: \(module.instructor) • \(module.credits) Credits"
        cell.contentConfiguration = content
        cell.accessoryType = .disclosureIndicator
        return cell
    }

    // MARK: - UITableViewDelegate (Task 2 & 3: Dependency Injection + Push Navigation)
    func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
        tableView.deselectRow(at: indexPath, animated: true)

        let selectedModule = modules[indexPath.row]
        let detailVC = CourseDetailViewController(module: selectedModule)

        // Safely push onto UINavigationController without force-unwrapping
        guard let navController = navigationController else {
            assertionFailure("CourseListViewController must be embedded inside a UINavigationController.")
            return
        }
        navController.pushViewController(detailVC, animated: true)
    }
}

// ============================================================================
// Screen 2: Detail View Controller (Tasks 1, 2, 3 & 5)
// ============================================================================
final class CourseDetailViewController: UIViewController {

    // Task 2: Model injected via initializer (zero global state)
    private let module: CourseModule

    // Task 5: Programmatic non-optional UI components (zero force-unwrapped @IBOutlets)
    private let codeBadgeLabel: UILabel = {
        let label = UILabel()
        label.font = .systemFont(ofSize: 13, weight: .bold)
        label.textColor = .systemBlue
        return label
    }()

    private let titleLabel: UILabel = {
        let label = UILabel()
        label.font = .systemFont(ofSize: 24, weight: .bold)
        label.numberOfLines = 0
        return label
    }()

    private let metaLabel: UILabel = {
        let label = UILabel()
        label.font = .systemFont(ofSize: 15, weight: .medium)
        label.textColor = .secondaryLabel
        label.numberOfLines = 0
        return label
    }()

    private let summaryLabel: UILabel = {
        let label = UILabel()
        label.font = .systemFont(ofSize: 16)
        label.numberOfLines = 0
        return label
    }()

    private let backButton: UIButton = {
        var config = UIButton.Configuration.tinted()
        config.title = "Back to Course List"
        return UIButton(configuration: config)
    }()

    init(module: CourseModule) {
        self.module = module
        super.init(nibName: nil, bundle: nil)
    }

    // Task 5: Safe fallback if storyboard/nib decoding is ever invoked unexpectedly
    required init?(coder: NSCoder) {
        assertionFailure("CourseDetailViewController requires a CourseModule via init(module:).")
        return nil
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        title = module.code
        view.backgroundColor = .systemBackground
        setupLayout()
        configureContent()
    }

    private func setupLayout() {
        let cardStack = UIStackView(arrangedSubviews: [
            codeBadgeLabel,
            titleLabel,
            metaLabel,
            summaryLabel,
            backButton
        ])
        cardStack.axis = .vertical
        cardStack.spacing = 12
        cardStack.translatesAutoresizingMaskIntoConstraints = false

        view.addSubview(cardStack)
        NSLayoutConstraint.activate([
            cardStack.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 20),
            cardStack.leadingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.leadingAnchor, constant: 20),
            cardStack.trailingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.trailingAnchor, constant: -20)
        ])

        backButton.addTarget(self, action: #selector(didTapBack), for: .touchUpInside)
    }

    private func configureContent() {
        codeBadgeLabel.text = module.code
        titleLabel.text = module.title
        metaLabel.text = "Instructor: \(module.instructor) | Credits: \(module.credits)"
        summaryLabel.text = module.summary
    }

    // Task 3: Programmatic pop back to root/previous screen
    @objc private func didTapBack() {
        navigationController?.popViewController(animated: true)
    }
}

