import Foundation

// ==============================================================================
// TASK 1: Define Protocol `Displayable` and Conform `Student` & `Course`
// ==============================================================================

protocol Displayable {
    var displayTitle: String { get }
    func summary() -> String
}

struct Student: Displayable {
    let id: String
    let name: String
    let cgpa: Double
    
    var displayTitle: String {
        return "\(name) (\(id))"
    }
    
    func summary() -> String {
        return "Student: \(displayTitle) | CGPA: \(String(format: "%.2f", cgpa))"
    }
}

struct Course: Displayable {
    let code: String
    let title: String
    let credits: Int
    
    var displayTitle: String {
        return "\(code): \(title)"
    }
    
    func summary() -> String {
        return "Course: \(displayTitle) | Credits: \(credits)"
    }
}

// ==============================================================================
// TASK 2: Extension Adding a Computed Property and Helper to an Existing Type
// ==============================================================================

extension String {
    /// Computed property that returns true if the string has non-whitespace characters
    var isNotBlank: Bool {
        return !self.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
    }
    
    /// Helper method to truncate long text cleanly with an ellipsis
    func truncated(to maxLength: Int) -> String {
        guard maxLength > 0, self.count > maxLength else { return self }
        return String(self.prefix(maxLength)) + "..."
    }
}

extension Array where Element: Numeric {
    /// Computed property to calculate the sum of numeric array elements
    var totalSum: Element {
        return reduce(0, +)
    }
}

// ==============================================================================
// TASK 3: Generic `Stack<T>` with `push`, `pop`, `peek`, and `isEmpty`
// ==============================================================================

struct Stack<T> {
    private var storage: [T] = []
    
    var isEmpty: Bool {
        return storage.isEmpty
    }
    
    var count: Int {
        return storage.count
    }
    
    mutating func push(_ element: T) {
        storage.append(element)
    }
    
    @discardableResult
    mutating func pop() -> T? {
        return storage.popLast()
    }
    
    func peek() -> T? {
        return storage.last
    }
}

// ==============================================================================
// TASK 4: Generic Function with Protocol Constraint (Valid vs. Invalid Use)
// ==============================================================================

/// Generic function constrained to types conforming to `Displayable`
func formatAllItems<T: Displayable>(_ items: [T]) -> [String] {
    return items.map { $0.summary() }
}

/// Another constrained generic helper requiring `Equatable`
func containsItem<T: Equatable>(_ target: T, in collection: [T]) -> Bool {
    return collection.contains(target)
}

// A type that intentionally does NOT conform to `Displayable`
struct RawScore {
    let value: Int
}

// ==============================================================================
// TASK 5: Why an Extension Cannot Replace a New Type for Stored State
// ==============================================================================

/*
 EXPLANATION (Task 5):
 In Swift, extensions can add computed properties, methods, initializers, subscripts,
 and protocol conformances to an existing type, but they CANNOT add stored properties
 (or property observers on existing stored properties).

 Why? Because adding stored properties changes the memory footprint and layout of
 every instance of that type—including types imported from external frameworks or
 the Swift standard library—which breaks ABI stability and compile-time memory allocation.

 Therefore, whenever a feature requires maintaining new per-instance stored state
 (such as `Stack<T>` holding `private var storage: [T]`), you must define a new
 `struct`, `class`, or `actor` rather than extending an existing type.
*/

