import UIKit

// MARK: - Validation Logic (Extracted for Unit Testing)
struct ProfileFormValidator {
    struct ValidationResult: Equatable {
        let nameError: String?
        let emailError: String?
        let courseError: String?

        var isValid: Bool {
            nameError == nil && emailError == nil && courseError == nil
        }
    }

    static func validate(name: String?, email: String?, course: String?) -> ValidationResult {
        let trimmedName = name?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
        let trimmedEmail = email?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
        let trimmedCourse = course?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""

        let nameError: String? = trimmedName.isEmpty ? "Full name is required." : nil

        let emailError: String?
        if trimmedEmail.isEmpty {
            emailError = "Email address is required."
        } else if !isValidEmail(trimmedEmail) {
            emailError = "Enter a valid email address (e.g., name@domain.com)."
        } else {
            emailError = nil
        }

        let courseError: String? = trimmedCourse.isEmpty ? "Course name is required." : nil

        return ValidationResult(nameError: nameError, emailError: emailError, courseError: courseError)
    }

    private static func isValidEmail(_ email: String) -> Bool {
        let pattern = #"^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$"#
        return email.range(of: pattern, options: [.regularExpression, .caseInsensitive]) != nil
    }
}

